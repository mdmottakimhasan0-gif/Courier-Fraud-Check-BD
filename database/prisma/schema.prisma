generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  PENDING
  ACTIVE
  LOCKED
  SUSPENDED
  BANNED
  DELETED
}

enum BillingCycle {
  MONTHLY
  YEARLY
  CUSTOM
}

enum SubscriptionStatus {
  TRIAL
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum PaymentProvider {
  BKASH
  NAGAD
  SSLCOMMERZ
  MANUAL
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum InvoiceStatus {
  DRAFT
  PENDING
  ISSUED
  PAID
  CANCELLED
  REFUNDED
  VOID
  OVERDUE
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum CourierProvider {
  STEADFAST
  PATHAO
  REDX
}

enum CourierAccountStatus {
  UNVERIFIED
  VERIFIED
  FAILED
  DISABLED
}

enum ProviderHealthStatus {
  ONLINE
  DEGRADED
  OFFLINE
  UNKNOWN
}

enum CircuitBreakerState {
  CLOSED
  OPEN
  HALF_OPEN
}

enum SearchStatus {
  PENDING
  QUEUED
  SEARCHING
  PARTIALLY_COMPLETED
  COMPLETED
  FAILED
  CANCELLED
  CACHED
}

enum RiskBadge {
  LOW
  MEDIUM
  HIGH
  CRITICAL
  UNKNOWN
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum MfaFactorType {
  TOTP
  RECOVERY_CODE
}

enum LoginRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum WebhookEventType {
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_UPDATED
  SUBSCRIPTION_CANCELLED
  PAYMENT_CREATED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  INVOICE_CREATED
  INVOICE_PAID
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  RETRYING
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum SupportTicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FileStorageProvider {
  LOCAL
  S3_COMPATIBLE
}

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @db.VarChar(160)
  slug      String       @unique @db.VarChar(120)
  status    TenantStatus @default(ACTIVE)
  metadata  Json?
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")

  users            User[]
  roles            Role[]
  plans            Plan[]
  subscriptions    Subscription[]
  payments         Payment[]
  invoices         Invoice[]
  coupons          Coupon[]
  promoCodes       PromoCode[]
  searchHistories  SearchHistory[]
  fraudResults     FraudResult[]
  courierAccounts  CourierAccount[]
  apiKeys          ApiKey[]
  authSessions     AuthSession[]
  suspiciousLoginEvents SuspiciousLoginEvent[]
  webhookEndpoints WebhookEndpoint[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  supportTickets   SupportTicket[]
  announcements    Announcement[]
  blogPosts        BlogPost[]
  systemSettings   SystemSetting[]
  featureFlags     FeatureFlag[]
  files            StoredFile[]

  @@index([status])
  @@index([deletedAt])
  @@map("tenants")
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  tenantId        String     @map("tenant_id") @db.Uuid
  name            String     @db.VarChar(160)
  email           String     @db.VarChar(190)
  phone           String?    @db.VarChar(32)
  passwordHash    String     @map("password_hash") @db.VarChar(255)
  status          UserStatus @default(PENDING)
  locale          String     @default("en") @db.VarChar(8)
  permissionVersion Int      @default(1) @map("permission_version")
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil     DateTime?  @map("locked_until")
  emailVerifiedAt DateTime?  @map("email_verified_at")
  lastLoginAt     DateTime?  @map("last_login_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  roles           UserRole[]
  subscriptions   Subscription[]
  searchHistories SearchHistory[]
  apiKeys         ApiKey[]
  authSessions    AuthSession[]
  passwordHistory PasswordHistory[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  mfaFactors      MfaFactor[]
  recoveryCodes   RecoveryCode[]
  emailChangeRequests EmailChangeRequest[]
  suspiciousLoginEvents SuspiciousLoginEvent[]
  notifications   Notification[]
  auditLogs       AuditLog[]       @relation("AuditActor")
  supportTickets  SupportTicket[]
  files           StoredFile[]

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@map("users")
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String    @db.VarChar(120)
  slug        String    @db.VarChar(120)
  description String?   @db.VarChar(255)
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  users       UserRole[]
  permissions RolePermission[]

  @@unique([tenantId, slug])
  @@index([tenantId, deletedAt])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  resource    String   @db.VarChar(120)
  action      String   @db.VarChar(80)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash") @db.VarChar(255)
  device           Json
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model PasswordHistory {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_history")
}

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model MfaFactor {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  factorType MfaFactorType @map("factor_type")
  secretHash String        @map("secret_hash") @db.VarChar(255)
  enabledAt  DateTime?     @map("enabled_at")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, factorType])
  @@index([userId, enabledAt])
  @@map("mfa_factors")
}

model RecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.VarChar(255)
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@index([userId, usedAt])
  @@map("recovery_codes")
}

model EmailChangeRequest {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  currentEmail String    @map("current_email") @db.VarChar(190)
  newEmail     String    @map("new_email") @db.VarChar(190)
  tokenHash    String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt    DateTime  @map("expires_at")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([newEmail])
  @@map("email_change_requests")
}

model SuspiciousLoginEvent {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  userId    String?        @map("user_id") @db.Uuid
  riskLevel LoginRiskLevel @map("risk_level")
  ipAddress String?        @map("ip_address") @db.VarChar(64)
  userAgent String?        @map("user_agent") @db.VarChar(500)
  reasons   Json
  metadata  Json?
  createdAt DateTime       @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, riskLevel, createdAt])
  @@index([userId, createdAt])
  @@map("suspicious_login_events")
}

model Plan {
  id                 String       @id @default(uuid()) @db.Uuid
  tenantId           String       @map("tenant_id") @db.Uuid
  name               String       @db.VarChar(120)
  slug               String       @db.VarChar(120)
  billingCycle       BillingCycle @map("billing_cycle")
  priceAmount        Decimal      @map("price_amount") @db.Decimal(12, 2)
  currency           String       @default("BDT") @db.VarChar(3)
  dailySearchLimit   Int          @map("daily_search_limit")
  monthlySearchLimit Int          @map("monthly_search_limit")
  apiRequestLimit    Int          @default(0) @map("api_request_limit")
  maxApiKeys         Int          @default(1) @map("max_api_keys")
  maxTeamMembers     Int          @default(1) @map("max_team_members")
  maxMerchantAccounts Int         @default(1) @map("max_merchant_accounts")
  maxSavedSearches   Int          @default(100) @map("max_saved_searches")
  searchHistoryRetentionDays Int  @default(30) @map("search_history_retention_days")
  historyLimit       Int          @map("history_limit")
  apiAccess          Boolean      @default(false) @map("api_access")
  priorityQueue      Boolean      @default(false) @map("priority_queue")
  premiumSupport     Boolean      @default(false) @map("premium_support")
  featureFlagAccess  Boolean      @default(false) @map("feature_flag_access")
  csvExport          Boolean      @default(false) @map("csv_export")
  pdfExport          Boolean      @default(false) @map("pdf_export")
  priorityRank       Int          @default(100) @map("priority_rank")
  isActive           Boolean      @default(true) @map("is_active")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  deletedAt          DateTime?    @map("deleted_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  subscriptions Subscription[]

  @@unique([tenantId, slug])
  @@index([tenantId, isActive])
  @@index([tenantId, deletedAt])
  @@map("plans")
}

model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  tenantId             String             @map("tenant_id") @db.Uuid
  userId               String             @map("user_id") @db.Uuid
  planId               String             @map("plan_id") @db.Uuid
  status               SubscriptionStatus @default(TRIALING)
  currentPeriodStart   DateTime           @map("current_period_start")
  currentPeriodEnd     DateTime           @map("current_period_end")
  cancelledAt          DateTime?          @map("cancelled_at")
  idempotencyKey       String?            @map("idempotency_key") @db.VarChar(160)
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  deletedAt            DateTime?          @map("deleted_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan     Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments Payment[]
  invoices Invoice[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, userId, status])
  @@index([tenantId, userId, status, currentPeriodEnd])
  @@index([tenantId, planId])
  @@index([tenantId, deletedAt])
  @@map("subscriptions")
}

model Payment {
  id                    String          @id @default(uuid()) @db.Uuid
  tenantId              String          @map("tenant_id") @db.Uuid
  subscriptionId        String?         @map("subscription_id") @db.Uuid
  provider              PaymentProvider
  status                PaymentStatus   @default(PENDING)
  amount                Decimal         @db.Decimal(12, 2)
  currency              String          @default("BDT") @db.VarChar(3)
  providerTransactionId String?         @map("provider_transaction_id") @db.VarChar(190)
  idempotencyKey        String          @map("idempotency_key") @db.VarChar(160)
  metadata              Json?
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")
  deletedAt             DateTime?       @map("deleted_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  invoices     Invoice[]

  @@unique([tenantId, idempotencyKey])
  @@unique([provider, providerTransactionId])
  @@index([tenantId, status])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
  @@map("payments")
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  subscriptionId String?       @map("subscription_id") @db.Uuid
  paymentId      String?       @map("payment_id") @db.Uuid
  invoiceNumber  String        @map("invoice_number") @db.VarChar(80)
  status         InvoiceStatus @default(DRAFT)
  subtotal       Decimal       @db.Decimal(12, 2)
  discountTotal  Decimal       @default(0) @map("discount_total") @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  currency       String        @default("BDT") @db.VarChar(3)
  sourceKey      String        @map("source_key") @db.VarChar(190)
  issuedAt       DateTime?     @map("issued_at")
  dueAt          DateTime?     @map("due_at")
  paidAt         DateTime?     @map("paid_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  payment      Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([tenantId, invoiceNumber])
  @@unique([tenantId, sourceKey])
  @@index([tenantId, status])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, deletedAt])
  @@map("invoices")
}

model Coupon {
  id              String     @id @default(uuid()) @db.Uuid
  tenantId        String     @map("tenant_id") @db.Uuid
  code            String     @db.VarChar(80)
  type            CouponType
  value           Decimal    @db.Decimal(12, 2)
  maxRedemptions  Int?       @map("max_redemptions")
  perUserRedemptionLimit Int? @map("per_user_redemption_limit")
  redeemedCount   Int        @default(0) @map("redeemed_count")
  startsAt        DateTime?  @map("starts_at")
  expiresAt       DateTime?  @map("expires_at")
  isActive        Boolean    @default(true) @map("is_active")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@index([tenantId, isActive, expiresAt])
  @@index([tenantId, deletedAt])
  @@map("coupons")
}

model PromoCode {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  code      String    @db.VarChar(80)
  couponId  String?   @map("coupon_id") @db.Uuid
  status    ContentStatus @default(DRAFT)
  payload   Json
  isActive  Boolean   @default(true) @map("is_active")
  startsAt  DateTime? @map("starts_at")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@index([tenantId, status])
  @@index([tenantId, couponId])
  @@index([tenantId, deletedAt])
  @@map("promo_codes")
}

model SearchHistory {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  userId          String?      @map("user_id") @db.Uuid
  normalizedPhone String       @map("normalized_phone") @db.VarChar(24)
  status          SearchStatus @default(PENDING)
  riskBadge       RiskBadge    @default(UNKNOWN) @map("risk_badge")
  riskScore       Int?         @map("risk_score")
  cacheKey        String?      @map("cache_key") @db.VarChar(190)
  idempotencyKey  String?      @map("idempotency_key") @db.VarChar(160)
  startedAt       DateTime?    @map("started_at")
  completedAt     DateTime?    @map("completed_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  deletedAt       DateTime?    @map("deleted_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  fraudResults FraudResult[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, normalizedPhone, createdAt])
  @@index([tenantId, userId, createdAt])
  @@index([tenantId, status])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, riskBadge, createdAt])
  @@index([tenantId, cacheKey])
  @@index([tenantId, deletedAt])
  @@map("search_histories")
}

model FraudResult {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String          @map("tenant_id") @db.Uuid
  searchHistoryId   String          @map("search_history_id") @db.Uuid
  provider          CourierProvider
  totalOrders       Int             @default(0) @map("total_orders")
  successfulOrders  Int             @default(0) @map("successful_orders")
  cancelledOrders   Int             @default(0) @map("cancelled_orders")
  successRate       Decimal         @default(0) @map("success_rate") @db.Decimal(5, 2)
  returnRate        Decimal         @default(0) @map("return_rate") @db.Decimal(5, 2)
  providerStatus    String          @map("provider_status") @db.VarChar(80)
  responseTimeMs    Int?            @map("response_time_ms")
  rawSummary        Json?           @map("raw_summary")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  deletedAt         DateTime?       @map("deleted_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  searchHistory SearchHistory @relation(fields: [searchHistoryId], references: [id], onDelete: Cascade)

  @@unique([searchHistoryId, provider])
  @@index([tenantId, provider, createdAt])
  @@index([tenantId, deletedAt])
  @@map("fraud_results")
}

model CourierAccount {
  id                         String                @id @default(uuid()) @db.Uuid
  tenantId                   String                @map("tenant_id") @db.Uuid
  provider                   CourierProvider
  label                      String                @db.VarChar(120)
  encryptedCredentials       String                @map("encrypted_credentials") @db.Text
  credentialVersion          Int                   @default(1) @map("credential_version")
  status                     CourierAccountStatus  @default(UNVERIFIED)
  healthStatus               ProviderHealthStatus  @default(UNKNOWN) @map("health_status")
  circuitBreakerState        CircuitBreakerState   @default(CLOSED) @map("circuit_breaker_state")
  averageResponseTimeMs      Int?                  @map("average_response_time_ms")
  failureRate                Decimal?              @map("failure_rate") @db.Decimal(5, 2)
  lastSuccessfulRequestAt    DateTime?             @map("last_successful_request_at")
  lastFailureAt              DateTime?             @map("last_failure_at")
  lastVerifiedAt             DateTime?             @map("last_verified_at")
  isActive                   Boolean               @default(true) @map("is_active")
  createdAt                  DateTime              @default(now()) @map("created_at")
  updatedAt                  DateTime              @updatedAt @map("updated_at")
  deletedAt                  DateTime?             @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, provider, label])
  @@index([tenantId, provider, isActive])
  @@index([tenantId, healthStatus])
  @@index([tenantId, deletedAt])
  @@map("courier_accounts")
}

model ApiKey {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  userId       String?      @map("user_id") @db.Uuid
  name         String       @db.VarChar(120)
  publicPrefix String       @map("public_prefix") @db.VarChar(32)
  keyHash      String       @map("key_hash") @db.VarChar(255)
  scopes       String[]
  status       ApiKeyStatus @default(ACTIVE)
  expiresAt    DateTime?    @map("expires_at")
  lastUsedAt   DateTime?    @map("last_used_at")
  revokedAt    DateTime?    @map("revoked_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  deletedAt    DateTime?    @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([publicPrefix])
  @@unique([tenantId, publicPrefix])
  @@unique([keyHash])
  @@index([tenantId, status])
  @@index([tenantId, userId])
  @@index([tenantId, deletedAt])
  @@map("api_keys")
}

model WebhookEndpoint {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  url           String    @db.VarChar(500)
  secretHash    String    @map("secret_hash") @db.VarChar(255)
  eventTypes    WebhookEventType[] @map("event_types")
  isActive      Boolean   @default(true) @map("is_active")
  failureCount  Int       @default(0) @map("failure_count")
  lastSuccessAt DateTime? @map("last_success_at")
  lastFailureAt DateTime? @map("last_failure_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  deliveries WebhookDelivery[]

  @@index([tenantId, isActive])
  @@index([tenantId, deletedAt])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id                String                @id @default(uuid()) @db.Uuid
  webhookEndpointId String                @map("webhook_endpoint_id") @db.Uuid
  eventType         WebhookEventType      @map("event_type")
  eventId           String                @map("event_id") @db.VarChar(160)
  status            WebhookDeliveryStatus @default(PENDING)
  attemptCount      Int                   @default(0) @map("attempt_count")
  nextAttemptAt     DateTime?             @map("next_attempt_at")
  deliveredAt       DateTime?             @map("delivered_at")
  responseStatus    Int?                  @map("response_status")
  responseBody      String?               @map("response_body") @db.Text
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  webhookEndpoint WebhookEndpoint @relation(fields: [webhookEndpointId], references: [id], onDelete: Cascade)

  @@unique([webhookEndpointId, eventId])
  @@index([status, nextAttemptAt])
  @@map("webhook_deliveries")
}

model Notification {
  id        String              @id @default(uuid()) @db.Uuid
  tenantId  String              @map("tenant_id") @db.Uuid
  userId    String?             @map("user_id") @db.Uuid
  channel   NotificationChannel
  status    NotificationStatus  @default(UNREAD)
  title     String              @db.VarChar(190)
  body      String              @db.Text
  metadata  Json?
  readAt    DateTime?           @map("read_at")
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")
  deletedAt DateTime?           @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, userId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
  @@map("notifications")
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  actorId       String?  @map("actor_id") @db.Uuid
  actorRole     String?  @map("actor_role") @db.VarChar(120)
  action        String   @db.VarChar(160)
  resourceType  String   @map("resource_type") @db.VarChar(120)
  resourceId    String?  @map("resource_id") @db.VarChar(120)
  ipAddress     String?  @map("ip_address") @db.VarChar(64)
  browser       String?  @db.VarChar(160)
  device        String?  @db.VarChar(160)
  previousValue Json?    @map("previous_value")
  newValue      Json?    @map("new_value")
  reason        String?  @db.VarChar(255)
  correlationId String   @map("correlation_id") @db.VarChar(120)
  createdAt     DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor  User?  @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, actorId, createdAt])
  @@index([tenantId, resourceType, resourceId])
  @@index([tenantId, correlationId])
  @@map("audit_logs")
}

model SupportTicket {
  id        String              @id @default(uuid()) @db.Uuid
  tenantId  String              @map("tenant_id") @db.Uuid
  userId    String?             @map("user_id") @db.Uuid
  subject   String              @db.VarChar(190)
