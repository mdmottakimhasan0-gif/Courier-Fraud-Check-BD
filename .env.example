# Courier Fraud Check BD environment template.
# Copy this file to .env for local development only.
# Never commit real production secrets.

# Application
NODE_ENV=development
APP_NAME="Courier Fraud Check BD"
APP_URL=http://localhost:3000
API_URL=http://localhost:4000/api/v1
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000/api/v1

# Backend
BACKEND_PORT=4000
API_VERSION=1
CORS_ORIGINS=http://localhost:3000
REQUEST_BODY_LIMIT=1mb
AUTH_COOKIE_DOMAIN=localhost

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Database and cache
DATABASE_URL=postgresql://user:password@localhost:5432/courier_fraud_check_bd
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=cfcb
QUEUE_DEFAULT_ATTEMPTS=3
QUEUE_RETRY_BACKOFF_MS=5000

# Security. Never commit real secrets.
JWT_ACCESS_SECRET=replace-with-development-secret
JWT_REFRESH_SECRET=replace-with-development-secret
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_LOGIN_RATE_WINDOW_SECONDS=300
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
AUTH_ACCOUNT_LOCKOUT_MINUTES=15
AUTH_PASSWORD_HISTORY_LIMIT=5
AUTH_COOKIE_SAME_SITE=lax
CREDENTIAL_ENCRYPTION_KEY=replace-with-32-byte-base64-key
TRUST_PROXY=true

# Payment gateway placeholders. Never commit real credentials.
BKASH_APP_KEY=replace-with-bkash-app-key
BKASH_APP_SECRET=replace-with-bkash-app-secret
BKASH_USERNAME=replace-with-bkash-username
BKASH_PASSWORD=replace-with-bkash-password
NAGAD_API_KEY=replace-with-nagad-api-key
NAGAD_API_SECRET=replace-with-nagad-api-secret
SSLCOMMERZ_STORE_ID=replace-with-sslcommerz-store-id
SSLCOMMERZ_STORE_PASSWORD=replace-with-sslcommerz-store-password

# Operations
LOG_LEVEL=info
LOG_RETENTION_DAYS=30
BACKUP_RETENTION_DAYS=14
UPLOADS_PATH=./uploads
LOGS_PATH=./logs

# Courier merchant credentials must be encrypted before database persistence.
